# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- CORS: comma-separated list of allowed frontend origins ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (async driver) ---
# psycopg3 async driver. Scheme MUST be postgresql+psycopg (a bare
# postgresql:// falls back to psycopg2, which is not installed).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rankpilot

# --- Security ---
# Signs & validates the API's own JWTs. Backend-only secret — the Next.js
# app never signs these tokens, it just carries them. (NextAuth uses its
# own separate NEXTAUTH_SECRET for the session cookie.)
SECRET_KEY=change-me-in-production
# 7 days, in minutes (kept in step with NextAuth session maxAge).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- OpenAI (Agents SDK reads OPENAI_API_KEY automatically) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Keyword clustering & Google Trends (pytrends) ---
# Minimum cosine similarity for two keywords to share a cluster.
KEYWORD_CLUSTER_THRESHOLD=0.5
# pytrends is rate-limited; cap terms fetched and pace batches.
KEYWORD_TREND_MAX_TERMS=20
KEYWORD_TREND_SLEEP=1.0

# --- Audit crawler tuning ---
AUDIT_MAX_LINKS_CHECKED=25
AUDIT_REQUEST_TIMEOUT=10.0

# --- Core Web Vitals (Google PageSpeed Insights API v5) ---
# Get a key: https://developers.google.com/speed/docs/insights/v5/get-started
# Free tier: 25,000 requests/day, 240/minute. Leave blank to run keyless
# (very low anonymous quota — fine for occasional local testing).
PAGESPEED_API_KEY=

# --- Rank Tracking (SerpApi) ---
# Required for live SERP positions. Free tier ~100 searches/month, paid
# beyond that. Get a key at https://serpapi.com/. Leave blank to disable.
SERPAPI_API_KEY=
SERPAPI_ENGINE=google
# Google deprecated num=100 — we paginate: PAGE_SIZE results x MAX_PAGES pages.
# Each page = 1 SerpApi search, so keep MAX_PAGES low on the free tier.
SERPAPI_PAGE_SIZE=10
SERPAPI_MAX_PAGES=3
# US targeting (location + gl/hl/google_domain for consistent regional SERPs).
SERPAPI_LOCATION=United States
SERPAPI_GL=us
SERPAPI_HL=en
SERPAPI_GOOGLE_DOMAIN=google.com
# Daily cron (runs in the ARQ worker): hour of day (server timezone).
RANK_TRACKING_ENABLED=true
RANK_TRACKING_HOUR=3

# --- Queue / worker (ARQ + Redis) ---
# The web process enqueues jobs to Redis; the ARQ worker runs them and owns
# the cron schedule. Start the worker separately: `arq app.worker.WorkerSettings`
REDIS_URL=redis://localhost:6379
QUEUE_KEEP_RESULT=3600

# --- Automation (email notifications; cron runs in the ARQ worker) ---
AUTOMATION_ENABLED=true
AUTOMATION_DAILY_HOUR=6
AUTOMATION_WEEKLY_DAY=mon
AUTOMATION_WEEKLY_HOUR=7
RANK_DROP_THRESHOLD=5
# Email via Resend (https://resend.com). Set EMAIL_PROVIDER=none to disable.
# Leave RESEND_API_KEY blank and notification emails are logged/skipped.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=RankPilot AI <noreply@rankpilot.ai>

# --- Backlink Center ---
# Free-tier backlink data (e.g. OpenLinkProfiler). Leave BACKLINK_API_URL
# blank to disable live lookups (UI shows "limited free data — not
# configured"). Swap provider + key for Ahrefs/Semrush later for full data.
BACKLINK_PROVIDER=openlinkprofiler
BACKLINK_API_URL=
BACKLINK_API_KEY=
BACKLINK_MAX=200
BACKLINK_MAX_LINKS_CHECKED=40
