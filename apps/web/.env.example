# Base URL of the FastAPI backend.
# Used by next.config rewrites (browser proxy) AND by NextAuth's
# server-side Credentials provider when it calls /api/v1/auth/login.
API_BASE_URL=https://hamzabhatti-rag-chatbot.hf.space

# Public URL exposed to the browser, if you call the API directly.
NEXT_PUBLIC_API_BASE_URL=https://hamzabhatti-rag-chatbot.hf.space/api/v1

# --- NextAuth ---
# Generate a strong secret, e.g.  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
